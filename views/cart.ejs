<!-- views/cart.ejs -->

<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-zinc-100 px-16 py-12">

    <!-- TOP HEADING -->
    <div class="mb-10 flex items-center justify-between">

        <div>
            <h1 class="text-4xl font-bold text-zinc-800">
                Shopping Cart
            </h1>

            <p class="text-zinc-500 mt-2">
                <%= user.cart.length %> Items in your cart
            </p>
        </div>

        <a 
            href="/shop"
            class="px-6 py-3 bg-black text-white rounded-xl hover:bg-zinc-800 transition"
        >
            Continue Shopping
        </a>

    </div>

    <!-- MAIN SECTION -->
    <div class="w-full flex gap-8 items-start">

        <!-- LEFT SIDE -->
        <div class="w-[65%] flex flex-col gap-6">

            <% user.cart.forEach(function(item){ %>

            <div class="w-full bg-white rounded-3xl shadow-sm hover:shadow-xl transition overflow-hidden border border-zinc-200">

                <div class="flex">

                    <!-- PRODUCT IMAGE -->
                    <div 
                        class="w-[35%] h-72 flex items-center justify-center"
                        style="background-color:<%= item.bgcolor %>"
                    >

                        <img 
                            class="h-52 object-contain hover:scale-110 transition duration-300"
                            src="data:image/png;base64,<%= item.image.toString('base64') %>" 
                            alt=""
                        >

                    </div>

                    <!-- PRODUCT DETAILS -->
                    <div class="w-[65%] p-8 flex flex-col justify-between">

                        <!-- NAME -->
                        <div>

                            <div class="flex items-start justify-between">

                                <div>

                                    <h2 
                                        class="text-3xl font-bold"
                                        style="color:<%= item.textcolor %>"
                                    >
                                        <%= item.name %>
                                    </h2>

                                    <p class="text-zinc-500 mt-2">
                                        Premium Quality Product
                                    </p>

                                </div>

                                <!-- REMOVE -->
                                <button class="text-zinc-400 hover:text-red-500 transition">
                                    <i class="ri-delete-bin-6-line text-2xl"></i>
                                </button>

                            </div>

                            <!-- PRICE -->
                            <div class="mt-6 flex items-center gap-4">

                                <h3 class="text-3xl font-bold text-green-600">
                                    ₹ <%= item.price %>
                                </h3>

                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm">
                                    In Stock
                                </span>

                            </div>

                        </div>

                        <!-- BOTTOM -->
                        <div class="flex items-center justify-between mt-8">

                            <!-- QUANTITY -->
                            <div class="flex items-center gap-3">

                                <button class="w-10 h-10 rounded-full bg-zinc-200 hover:bg-zinc-300 transition flex items-center justify-center">
                                    <i class="ri-subtract-line text-lg"></i>
                                </button>

                                <div class="px-5 py-2 rounded-xl bg-zinc-100 text-lg font-semibold">
                                    01
                                </div>

                                <button class="w-10 h-10 rounded-full bg-black text-white hover:bg-zinc-800 transition flex items-center justify-center">
                                    <i class="ri-add-line text-lg"></i>
                                </button>

                            </div>

                            <!-- TOTAL -->
                            <div class="text-right">

                                <p class="text-zinc-500">
                                    Net Total
                                </p>

                                <h2 class="text-2xl font-bold text-zinc-800">
                                    ₹ <%= item.price %>
                                </h2>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <% }) %>

        </div>

        <!-- RIGHT SIDE -->
        <div class="w-[35%] sticky top-10">

            <div class="bg-white rounded-3xl shadow-lg p-8 border border-zinc-200">

                <h2 class="text-3xl font-bold text-zinc-800">
                    Order Summary
                </h2>

                <p class="text-zinc-500 mt-2">
                    Price details of your cart
                </p>

                <!-- PRICE DETAILS -->
                <div class="mt-8 flex flex-col gap-5">

                    <div class="flex justify-between text-lg">

                        <h4 class="text-zinc-600">
                            Total MRP
                        </h4>

                        <h4 class="font-semibold">
                            ₹ <%= totalMRP %>
                        </h4>

                    </div>

                    <div class="flex justify-between text-lg">

                        <h4 class="text-zinc-600">
                            Discount
                        </h4>

                        <h4 class="font-semibold text-green-600">
                            - ₹ <%= totalDiscount %>
                        </h4>

                    </div>

                    <div class="flex justify-between text-lg">

                        <h4 class="text-zinc-600">
                            Platform Fee
                        </h4>

                        <h4 class="font-semibold">
                            ₹ 20
                        </h4>

                    </div>

                    <div class="flex justify-between text-lg">

                        <h4 class="text-zinc-600">
                            Shipping
                        </h4>

                        <h4 class="font-semibold text-green-600">
                            FREE
                        </h4>

                    </div>

                </div>

                <!-- DIVIDER -->
                <div class="w-full h-[1px] bg-zinc-200 my-8"></div>

                <!-- FINAL TOTAL -->
                <div class="flex items-center justify-between">

                    <div>

                        <h3 class="text-xl font-semibold text-zinc-800">
                            Total Amount
                        </h3>

                        <p class="text-zinc-500 text-sm mt-1">
                            Inclusive of all taxes
                        </p>

                    </div>

                    <h2 class="text-3xl font-bold text-green-600">
                        ₹ <%= finalBill %>
                    </h2>

                </div>

                <!-- BUTTON -->
                <button class="w-full mt-8 py-4 rounded-2xl bg-black text-white text-lg font-semibold hover:bg-zinc-800 transition">

                    Proceed to Checkout

                </button>

                <!-- SAFE PAYMENT -->
                <div class="mt-6 flex items-center justify-center gap-2 text-zinc-500">

                    <i class="ri-shield-check-line text-xl"></i>

                    <p class="text-sm">
                        Safe & Secure Payments
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>